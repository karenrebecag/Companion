{
  "manifest_version": 3,
  "name": "Companion Browser",
  "version": "0.1.0",
  "description": "Lets Companion read and operate the tabs you lend it, through a local native host.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": { "ids": [] },
  "background": { "service_worker": "background.js", "type": "module" }
}
